include=~/.config/mako/mako-colors

sort=-time
layer=top
anchor=top-left
width=300
height=110
border-size=2
border-radius=8
margin=12
padding=2

font=JetBrains Mono Nerd Font 11
markup=1
format=<b>%a </b> %s\n%b

icons=1
max-icon-size=64
icon-location=left

default-timeout=5000
ignore-timeout=0
max-visible=3
group-by=app-name

height=45

on-button-left=dismiss
on-button-middle=dismiss-all
on-button-right=exec makoctl menu wmenu -p 'Choose action' -H 300 -W 300

